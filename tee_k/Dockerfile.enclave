# check=skip=SecretsUsedInArgOrEnv
# Go 1.26.2 / Alpine 3.21 -- update digest when upgrading Go
FROM golang:alpine@sha256:80fbb8f9b2fa541a7d34378f1ad10f4f1c433817c4ed39ddb3e2f3ec3e961271 AS app-builder
ENV CGO_ENABLED=0
WORKDIR /app

# Copy shared dependencies first
COPY --chown=0:0 shared/ /app/shared/
COPY --chown=0:0 minitls/ /app/minitls/
COPY --chown=0:0 oprfmpc/ /app/oprfmpc/
COPY --chown=0:0 proto/*.go /app/proto/

# Copy TEE_K source files
COPY --chown=0:0 tee_k/*.go /app/tee_k/
COPY --chown=0:0 go.mod /app/go.mod
COPY --chown=0:0 go.sum /app/go.sum

WORKDIR /app/tee_k

# Build TEE_K enclave binary
RUN go build -trimpath -buildvcs=false --ldflags '-s -w -buildid= -extldflags=-static' -tags 'enclave osusergo netgo static_build' -o tee_k_enclave .

# Copy MPC pkg directory for runtime circuit compilation
RUN mkdir -p /mpcl && cp -r $(go env GOMODCACHE)/github.com/markkurossi/mpc@*/pkg /mpcl/

FROM scratch

# Copy CA certificates for HTTPS
COPY --chown=0:0 --from=app-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy TEE_K enclave binary
COPY --chown=0:0 --from=app-builder /app/tee_k/tee_k_enclave /tee_k_enclave
# Copy environment configuration
COPY --chown=0:0 deploy/tee_k.env /.env

# Copy MPC pkg directory for circuit compilation
COPY --chown=0:0 --from=app-builder /mpcl/pkg /mpcl/pkg

# Set MPCLDIR for MPC circuit compiler
ENV MPCLDIR=/mpcl

# Declare environment variables that can be overridden at runtime
# This is required for GCP Confidential Space
ENV EXPECTED_TEET_PCR0=""
ENV ENCLAVE_DOMAIN=""
ENV TEET_URL=""
ENV GOOGLE_PROJECT_ID=""
ENV GOOGLE_KMS_LOCATION=""
ENV GOOGLE_KMS_KEYRING=""
ENV GOOGLE_KMS_KEY=""
ENV GCP_PROJECT_ID=""

# GCP Confidential Space launch policy: allow these env vars to be overridden
LABEL "tee.launch_policy.allow_env_override"="EXPECTED_TEET_PCR0,ENCLAVE_DOMAIN,TEET_URL,GOOGLE_PROJECT_ID,GOOGLE_KMS_LOCATION,GOOGLE_KMS_KEYRING,GOOGLE_KMS_KEY,GCP_PROJECT_ID"

# Expose ports
EXPOSE 80 443

# Set entrypoint
ENTRYPOINT ["/tee_k_enclave"] 