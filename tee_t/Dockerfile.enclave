# check=skip=SecretsUsedInArgOrEnv
# Go 1.26.6 -- update digest when upgrading Go
FROM golang:1.26.6-alpine3.24@sha256:1a9c10cf505a9e6b1e96ea77ebdbfe79a0f10380181faf88bc3b51d7e4315fae AS app-builder
ENV CGO_ENABLED=0
WORKDIR /app

# Copy shared dependencies first
COPY --chown=0:0 shared/ /app/shared/
COPY --chown=0:0 minitls/ /app/minitls/
COPY --chown=0:0 mpc/ /app/mpc/
COPY --chown=0:0 proto/*.go /app/proto/

# Copy TEE_T source files
COPY --chown=0:0 tee_t/*.go /app/tee_t/
COPY --chown=0:0 go.mod /app/go.mod
COPY --chown=0:0 go.sum /app/go.sum

WORKDIR /app/tee_t

# Build TEE_T enclave binary
RUN go build -trimpath --ldflags '-s -w -buildid= -extldflags=-static' -tags 'enclave osusergo netgo static_build' -o tee_t_enclave .

# Copy the MPC stdlib (pkg/) for runtime circuit compilation, sourced from
# the module cache (go.mod replaces markkurossi/mpc with our fork).
RUN mkdir -p /mpcl && cp -r "$(go list -m -f '{{.Dir}}' github.com/markkurossi/mpc)/pkg" /mpcl/

FROM scratch

# Copy CA certificates for HTTPS
COPY --chown=0:0 --from=app-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy TEE_T enclave binary
COPY --chown=0:0 --from=app-builder /app/tee_t/tee_t_enclave /tee_t_enclave
# Copy environment configuration
COPY --chown=0:0 deploy/tee_t.env /.env

# Copy MPC pkg directory for circuit compilation
COPY --chown=0:0 --from=app-builder /mpcl/pkg /mpcl/pkg

# Set MPCLDIR for MPC circuit compiler
ENV MPCLDIR=/mpcl

# Declare environment variables that can be overridden at runtime
# This is required for GCP Confidential Space
ENV EXPECTED_TEEK_PCR0=""
ENV ENCLAVE_DOMAIN=""
ENV GOOGLE_PROJECT_ID=""
ENV GOOGLE_KMS_LOCATION=""
ENV GOOGLE_KMS_KEYRING=""
ENV GOOGLE_KMS_KEY=""
ENV GCP_PROJECT_ID=""

# GCP Confidential Space launch policy: allow these env vars to be overridden
LABEL "tee.launch_policy.allow_env_override"="GOOGLE_PROJECT_ID,GOOGLE_KMS_LOCATION,GOOGLE_KMS_KEYRING,GOOGLE_KMS_KEY,GCP_PROJECT_ID,PORT,ROUTER_URL,PEER_ADDR,EXPECTED_PEER_IMAGE_DIGEST,EXPECTED_PEER_BASE_DIGEST,JWT_PUBLIC_KEY,EXPECTED_JWT_ISSUER,KMS_ENCLAVE_DOMAIN_KEY,SELF_ADDR"

# Expose ports
EXPOSE 80 443

# Set entrypoint
ENTRYPOINT ["/tee_t_enclave"] 
