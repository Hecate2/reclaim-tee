# check=skip=SecretsUsedInArgOrEnv
# Go 1.26.2 / Alpine 3.21 -- update digest when upgrading Go
FROM golang:alpine@sha256:f85330846cde1e57ca9ec309382da3b8e6ae3ab943d2739500e08c86393a21b1 AS app-builder
ENV CGO_ENABLED=0
RUN apk add --no-cache --update ca-certificates
WORKDIR /app

# Copy shared dependencies first
COPY shared/ /app/shared/
COPY minitls/ /app/minitls/
COPY oprfmpc/ /app/oprfmpc/
COPY proto/*.go /app/proto/

# Copy TEE_T source files
COPY tee_t/*.go /app/tee_t/
COPY go.mod /app/go.mod
COPY go.sum /app/go.sum

WORKDIR /app/tee_t

# Build TEE_T enclave binary
RUN go build -trimpath -buildvcs=false --ldflags '-s -w -extldflags=-static' -tags 'enclave osusergo netgo static_build' -o tee_t_enclave .

# Copy MPC pkg directory for runtime circuit compilation
RUN mkdir -p /mpcl && cp -r $(go env GOMODCACHE)/github.com/markkurossi/mpc@*/pkg /mpcl/

FROM scratch

# Copy CA certificates for HTTPS
COPY --from=app-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy TEE_T enclave binary
COPY --from=app-builder /app/tee_t/tee_t_enclave /tee_t_enclave
# Copy environment configuration
COPY deploy/tee_t.env /.env

# Copy MPC pkg directory for circuit compilation
COPY --from=app-builder /mpcl/pkg /mpcl/pkg

# Set MPCLDIR for MPC circuit compiler
ENV MPCLDIR=/mpcl

# Declare environment variables that can be overridden at runtime
# This is required for GCP Confidential Space
ENV EXPECTED_TEEK_PCR0=""
ENV ENCLAVE_DOMAIN=""
ENV GOOGLE_PROJECT_ID=""
ENV GOOGLE_KMS_LOCATION=""
ENV GOOGLE_KMS_KEYRING=""
ENV GOOGLE_KMS_KEY=""
ENV GCP_PROJECT_ID=""

# GCP Confidential Space launch policy: allow these env vars to be overridden
LABEL "tee.launch_policy.allow_env_override"="EXPECTED_TEEK_PCR0,ENCLAVE_DOMAIN,GOOGLE_PROJECT_ID,GOOGLE_KMS_LOCATION,GOOGLE_KMS_KEYRING,GOOGLE_KMS_KEY,GCP_PROJECT_ID"

# Expose ports
EXPOSE 80 443

# Set entrypoint
ENTRYPOINT ["/tee_t_enclave"] 