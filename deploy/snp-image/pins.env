# Committable build pins for the SEV-SNP image — the SNP analogue of the CS
# pinned Dockerfiles. Sourced by deploy/snp-build.sh (and read by snp-pair.sh
# for the peer digest) so the base UKI (PCR 11) and the app bundle (PCR 8 /
# snp-app digest) are byte-reproducible. Bumping a value here is the ONLY way
# the measured identity changes — do it deliberately. No deployment-specific
# data: public package versions + the build's own digests.

# --- builder environment (Docker base + tools whose output lands in the UKI) ---
# Pinned by digest/version so a fresh build days later is bit-identical, not just
# within a cached image. dosfstools/mtools/python3 omitted: unmeasured disk only.
SNP_UBUNTU_DIGEST="sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517"
# Immutable Ubuntu archive state containing every package version below. The
# timestamp matches the recorded reproducible-build epoch in image-history.json.
SNP_APT_SNAPSHOT="20260821T133530Z"
SNP_ZSTD_VER="1.5.5+dfsg2-2build1.1"
SNP_CPIO_VER="2.15+dfsg-1ubuntu2"
SNP_BINUTILS_VER="2.42-4ubuntu2.10"
SNP_SYSTEMD_VER="255.4-1ubuntu8.17"

# --- base UKI inputs (PCR 11, per-cloud kernel + systemd stub/ukify) ---
SNP_GCP_KERNEL_PKG="linux-image-6.17.0-1022-gcp=6.17.0-1022.25"
SNP_AWS_KERNEL_PKG="linux-image-7.0.0-1011-aws=7.0.0-1011.11~24.04.1"
SNP_SYSTEMD_BOOT_VER="255.4-1ubuntu8.17"
SNP_SYSTEMD_UKIFY_VER="255.4-1ubuntu8.17"
# The loader is measured into PCR 11. Keep this pin stable until a deliberate
# base-image rebuild and router/attestor re-pin.
SNP_LOADER_GO_TOOLCHAIN="go1.27.0"

# --- app bundle inputs (PCR 8 / snp-app digest) ---
# TEE services are measured in the replaceable app bundle, so their Go
# toolchain can advance independently of the loader and base-image identity.
SNP_TEE_GO_TOOLCHAIN="go1.27.0"
# CA bundle: extracted at build time from this pinned alpine (ships a Mozilla
# bundle at /etc/ssl/certs/ca-certificates.crt). NOT host certs. Bump to update.
SNP_CA_IMAGE="alpine@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d"

# --- base UKI hash (sha256 of snp-base.efi), per cloud — COMMIT-INDEPENDENT ---
# snp-build.sh asserts the built base UKI matches; a mismatch means unexpected
# base drift (kernel/loader/systemd/cmdline). App digests are NOT pinned here:
# they track the commit and are recorded in image-history.json + allowlisted.
SNP_BASE_UKI_GCP="2a1063c15dc66c65883f33279a164aa116c386e65694230c31820f6f07b95485"
SNP_BASE_UKI_AWS="77e4e692bdd3396ca486e8194c93b154c91a90879a847b2b2ae8ce5c5f1090fe"

# --- base UKI identity (snp-base:<PCR 11>) per cloud — the value attested at
# runtime and pinned at register + RA-TLS. GCP PCR 11 = SHA256, AWS = SHA384.
# Emitted by the build as "snp-base (PCR11 ...) = ...". Allowlist both; pass both
# to EXPECTED_PEER_BASE_DIGEST so either side accepts its peer regardless of cloud.
SNP_BASE_DIGEST_GCP="snp-base:848bc6bf294c76d2002ee313d8994a1601fa4ed478a017d0b3cc7a50a30bfc11"
SNP_BASE_DIGEST_AWS="snp-base:5451db58f0e355b07a81c4b7f0675cc1f2c27d91e82f564837ab92afd2b32c68f190486995677b5162cd7c6f1cade1b5"
