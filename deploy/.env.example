# Operator-specific configuration for the deploy/*.sh scripts.
#
# Copy this file to deploy/.env and fill in your deployment's values.
# deploy/.env is gitignored; this template (with no real values) is
# committed so anyone forking the repo can see what to populate.
#
# Every script under deploy/ sources deploy/.env at startup and then
# validates that the required vars are non-empty. Forgetting one will
# fail loudly at the top of the script, not midway through a deploy.

# ─── GCP project + region ───────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id
GCP_ZONE=asia-south2-a   # TEEs co-locate in this zone; REGION is derived as the leading part (asia-south2)

# ─── Router ─────────────────────────────────────────────────────────────
ROUTER_URL=https://your-router.example.com    # custom domain pointing at the Cloud Run service via LB
ROUTER_SERVICE_NAME=router                    # Cloud Run service name in GCP_PROJECT
ROUTER_AR_REPO=router                         # Artifact Registry repo holding the router image
ROUTER_JWT_ISSUER=router.your-domain.example  # `iss` claim the router stamps on /allocate JWTs (TEEs verify this)
# Path tail under projects/<P>/locations/<REGION>/keyRings/<KEYRING>/cryptoKeys
# — pin a specific cryptoKeyVersion so KMS rotations are an explicit deploy.
ROUTER_KMS_KEY_VERSION=cryptoKeys/router-jwt-signing/cryptoKeyVersions/1

# Admin bearer for /allowlist + /pairs/{id}/drain + /pairs/{id}/dead.
# Generate with: openssl rand -hex 32  (or any sufficient entropy source).
# The router validates this with crypto/subtle constant-time compare.
ROUTER_ADMIN_TOKEN=put-a-strong-random-secret-here

# ─── TEEs ───────────────────────────────────────────────────────────────
TEES_AR_REPO=tees-v2          # AR repo for tee-k + tee-t images
TEE_NET_TAG=tee-v2            # GCE network tag (firewall + label scoping)
TEE_K_VM_PREFIX=tee-k-v2      # VM names are ${PREFIX}-${N} (e.g. tee-k-v2-3)
TEE_T_VM_PREFIX=tee-t-v2      # ditto for T side
TEE_PORT=443                  # TLS port the TEEs serve on (must match Dockerfile EXPOSE)
KMS_KEYRING=reclaim-keyring   # KMS keyring containing the TEE deployment keys

# SA emails the TEE VMs run as. Must match APPROVED_SA_PATTERN on the router.
TEE_K_SA=tee-k-sa@your-gcp-project-id.iam.gserviceaccount.com
TEE_T_SA=tee-t-sa@your-gcp-project-id.iam.gserviceaccount.com

# Per-side KMS envelope encryption for OPRF shares in Secret Manager.
# Keys live in their respective locations; the *_DEPLOYMENT_KEY string
# disambiguates the secret name and stays stable across deploys.
TEE_K_KMS_LOCATION=asia-south2
TEE_K_KMS_KEY=tk-key
TEE_K_DEPLOYMENT_KEY=tk.your-domain.example
TEE_T_KMS_LOCATION=us-central1
TEE_T_KMS_KEY=tt-key
TEE_T_DEPLOYMENT_KEY=tt.your-domain.example

# ─── SEV-SNP test deployment (snp-pair.sh / snp-aws-pair.sh / images / router) ──
SNP_ROUTER_URL=https://your-test-router.example.com   # isolated test router (NOT prod)
SNP_JWT_ISSUER=test-router.your-domain.example        # `iss` the test router stamps
SNP_PAIR_GCP_ZONE=us-central1-a                       # zone for the GCP half of a pair
SNP_PAIR_AWS_REGION=us-east-2                          # region for the AWS half of a pair
SNP_ZONE=us-central1-a                                # zone for snp-gcp-image/poc/measure
AWS_SNP_REGION=us-east-2                               # region for snp-aws-image/poc
# app-bundle digests are NOT pinned (they track the commit): recorded in
# deploy/image-history.json and passed to snp-pair.sh per run via
# SNP_K_DIGEST / SNP_T_DIGEST (from that build's output). Bases live in pins.env.
# Test router (snp-test-router.sh) — names are yours to choose; domain points at SNP_TEST_ADDR
SNP_TEST_DOMAIN=test-router.your-domain.example
SNP_TEST_REGION=asia-south2
SNP_TEST_SERVICE=test-router
SNP_TEST_DB=test-router
SNP_TEST_ADDR=test-router-ip
SNP_TEST_RUNTIME_SA_NAME=test-router-runtime
