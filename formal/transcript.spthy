theory Transcript
begin

/*
  Transcript generation and verification (Algorithm 5 / Algorithm 6).

    sigma_K = Sign_skK( session_id || R_red || Str_Dec,Red || Certificate )
    sigma_A = Sign_skA( session_id || Resp_enc || T_resp || Str_SP )

  Both signed payloads carry the session id (proto/signing.proto:12,32,
  "Shared session ID for cross-TEE binding"), and the verifier requires the
  two to be equal -- modelled by using the same variable in both bodies.
  Session ids are TEE-generated random UUIDs (shared/session_manager.go:74)
  pushed from TEE_K to TEE_A, so a user can neither choose nor collide them.

  That binding is load-bearing, because the verifier reconstructs the
  response by XORing a value taken from sigma_A with a value taken from
  sigma_K. See transcript_negctl_nobinding.spthy for the ablation.

  The user is the adversary here: the whole point of a proof of provenance
  is that the user must not be able to fabricate one. TEE_K and TEE_A are
  honest; their mutual channel is secure; the user drives both. The user may
  run sessions against the honest site 'bank' and against any site it
  controls (it cannot obtain a certificate for 'bank').
*/

builtins: xor, signing
functions: ks/2, tagsec/1, mac/2

restriction Equality:   "All x y #i. Eq(x,y) @ i ==> x = y"
restriction Inequality: "All x #i. Neq(x,x) @ i ==> F"

rule Register_TEEs:
  [ Fr(~skK), Fr(~skT) ]
  --[ Register() ]->
  [ !LtkK(~skK), !LtkT(~skT), !PkK(pk(~skK)), !PkT(pk(~skT))
  , Out(<pk(~skK), pk(~skT)>) ]

restriction OnePair: "All #i #j. Register() @ i & Register() @ j ==> #i = #j"

// ---- session against the honest website ----

rule Session_Honest:
  [ Fr(~sid), Fr(~kdec), Fr(~nr) ]
  --[ StartHonest(~sid) ]->
  [ K_S(~sid, 'bank', ~kdec, ~nr)
  , W_S(~sid, ~kdec, ~nr)
  , T_S(~sid, ~kdec) ]

rule W_Send:
  let re = ~content ⊕ ks(~kdec, ~nr)
      tr = mac(tagsec(~kdec), re)
  in
  [ W_S(~sid, ~kdec, ~nr), Fr(~content) ]
  --[ Genuine('bank', ~content) ]->
  [ Out(<re, tr>) ]

// ---- session against a site the user controls ----

rule Session_Evil:
  [ Fr(~sid), Fr(~kdec), Fr(~nr) ]
  --[ Neq($E, 'bank'), StartEvil(~sid) ]->
  [ K_S(~sid, $E, ~kdec, ~nr)
  , T_S(~sid, ~kdec)
  , Out(<~kdec, ~nr>) ]

// ---- TEE_A: verify the response tag, then sign ----

rule T_Accept:
  [ T_S(~sid, ~kdec), In(<re, tr>) ]
  --[ Eq(tr, mac(tagsec(~kdec), re)) ]->
  [ T_Ready(~sid, re) ]

rule T_Sign:
  let body = <'TOut', ~sid, re> in
  [ T_Ready(~sid, re), !LtkT(~skT) ]
  --[ SignedT(~sid) ]->
  [ Out(<body, sign(body, ~skT)>) ]

// ---- TEE_K: release the keystream and sign ----

rule K_Sign:
  let sdr  = ks(~kdec, ~nr)
      body = <'KOut', ~sid, cert, sdr>
  in
  [ K_S(~sid, cert, ~kdec, ~nr), !LtkK(~skK) ]
  --[ SignedK(~sid, cert) ]->
  [ Out(<body, sign(body, ~skK)>) ]

// ---- verifier (Algorithm 6) ----

rule Verifier:
  let bodyK = <'KOut', sid, cert, sdr>
      bodyT = <'TOut', sid, re>
  in
  [ In(<bodyK, sigK, bodyT, sigT>), !PkK(pkK), !PkT(pkT) ]
  --[ Eq(verify(sigK, bodyK, pkK), true)
    , Eq(verify(sigT, bodyT, pkT), true)
    , Accept(cert, re ⊕ sdr) ]->
  [ ]

// Non-repudiation (whitepaper Property 4, line 305): if a verifier accepts
// content attributed to the honest site, that site really sent it.
lemma no_forged_transcript:
  all-traces
  "All content #i. Accept('bank', content) @ i
     ==> Ex #j. Genuine('bank', content) @ j"

lemma sanity_honest_run:
  exists-trace
  "Ex content #i #j. Genuine('bank', content) @ i & Accept('bank', content) @ j"


// Sharper form: can the user make a verifier accept a value the user picked
// outright, attributed to the honest site?
lemma chosen_content_forgery:
  exists-trace
  "Ex #i. Accept('bank', 'attacker_chosen') @ i"

end
